e="Tunnel"><a name="label" val="A" /><a name="facing" val="west" /></comp><wire from="(600,310)" to="(660,310)" /><comp lib="0" loc="(660,330)" name="Tunnel"><a name="label" val="B" /><a name="facing" val="west" /></comp><wire from="(600,330)" to="(660,330)" /><comp lib="0" loc="(660,350)" name="Tunnel"><a name="label" val="C" /><a name="facing" val="west" /></comp><wire from="(600,350)" to="(660,350)" /><comp lib="0" loc="(660,370)" name="Tunnel"><a name="label" val="D" /><a name="facing" val="west" /></comp><wire from="(600,370)" to="(660,370)" /><comp lib="0" loc="(660,390)" name="Tunnel"><a name="label" val="E" /><a name="facing" val="west" /></comp><wire from="(600,390)" to="(660,390)" /><comp lib="0" loc="(660,410)" name="Tunnel"><a name="label" val="F" /><a name="facing" val="west" /></comp><wire from="(600,410)" to="(660,410)" /><comp lib="0" loc="(660,430)" name="Tunnel"><a name="label" val="G" /><a name="facing" val="west" /></comp><wire from="(600,430)" to="(660,430)" /><comp lib="6" loc="(900,350)" name="7-Segment Display"><a name="decimalPoint" val="false" /><a name="labelloc" val="east" /><a name="label" val="Result" /></comp><comp lib="0" loc="(900,250)" name="Tunnel"><a name="label" val="G" /><a name="facing" val="south" /></comp><wire from="(900,250)" to="(900,350)" /><comp lib="0" loc="(910,280)" name="Tunnel"><a name="label" val="F" /><a name="facing" val="south" /></comp><wire from="(910,280)" to="(910,350)" /><comp lib="0" loc="(920,220)" name="Tunnel"><a name="label" val="A" /><a name="facing" val="south" /></comp><wire from="(920,220)" to="(920,350)" /><comp lib="0" loc="(930,190)" name="Tunnel"><a name="label" val="B" /><a name="facing" val="south" /></comp><wire from="(930,190)" to="(930,350)" /><comp lib="0" loc="(900,440)" name="Tunnel"><a name="label" val="E" /><a name="facing" val="north" /></comp><wire from="(900,410)" to="(900,440)" /><comp lib="0" loc="(910,470)" name="Tunnel"><a name="label" val="D" /><a name="facing" val="north" /></comp><wire from="(910,410)" to="(910,470)" /><comp lib="0" loc="(920,500)" name="Tunnel"><a name="label" val="C" /><a name="facing" val="north" /></comp><wire from="(920,410)" to="(920,500)" /></circuit><vhdl appearance="logisim_evolution" name="count16_7seg">library IEEE;
use IEEE.STD_LOGIC_1164.ALL;

entity count16_7seg is
    port (
        vt : in STD_LOGIC_VECTOR(15 downto 0);
        en : in STD_LOGIC;
        sa, sb, sc, sd, se, sf, sg : out STD_LOGIC
    );
end count16_7seg;

architecture Behavioral of count16_7seg is
    -- Segment order: a b c d e f g
    -- '1' = ON, '0' = OFF
    signal segments : STD_LOGIC_VECTOR(6 downto 0);
begin
    process(vt, en)
        variable count : integer range 0 to 16;
    begin
        count := 0;

        for i in vt'range loop
            if vt(i) = '1' then
                count := count + 1;
            end if;
        end loop;

        if en = '1' then
            case count is
                when 0  =&gt; segments &lt;= "1111110"; -- 0
                when 1  =&gt; segments &lt;= "0110000"; -- 1
                when 2  =&gt; segments &lt;= "1101101"; -- 2
                when 3  =&gt; segments &lt;= "1111001"; -- 3
                when 4  =&gt; segments &lt;= "0110011"; -- 4
                when 5  =&gt; segments &lt;= "1011011"; -- 5
                when 6  =&gt; segments &lt;= "1011111"; -- 6
                when 7  =&gt; segments &lt;= "1110000"; -- 7
                when 8  =&gt; segments &lt;= "1111111"; -- 8
                when 9  =&gt; segments &lt;= "1111011"; -- 9
                when 10 =&gt; segments &lt;= "1110111"; -- A
                when 11 =&gt; segments &lt;= "0011111"; -- b
                when 12 =&gt; segments &lt;= "1001110"; -- C
                when 13 =&gt; segments &lt;= "0111101"; -- d
                when 14 =&gt; segments &lt;= "1001111"; -- E
                when 15 =&gt; segments &lt;= "1000111"; -- F
                when others =&gt; segments &lt;= "0000000";
            end case;
        else
            segments &lt;= "0000000";
        end if;
    end process;

    sa &lt;= segments(6);
    sb &lt;= segments(5);
    sc &lt;= segments(4);
    sd &lt;= segments(3);
    se &lt;= segments(2);
    sf &lt;= segments(1);
    sg &lt;= segments(0);
end Behavioral;
</vhdl></project>